node_modules/

# Local state, not source
data/*.db
data/*.db-shm
data/*.db-wal
data/cover-cache.json
logs/

# Secrets and machine-specific overrides. Deep-merged over config.json at load.
# The Discord webhook is a bearer credential: anyone holding the URL can post to
# the channel, and a commit publishes it permanently even if later removed.
config/config.local.json

.DS_Store

# Your property. Exact coordinates for stands, bedding, food and water.
# Seeded from config/map.example.json on first run.
config/map.json

# Climate normals, generated by `npm run setup` for your coordinates.
data/normals*.json
