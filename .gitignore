node_modules/

# Local state, not source
data/*.db
data/*.db-shm
data/*.db-wal
data/cover-cache.json
logs/

# Secrets and machine-specific overrides. Deep-merged over config.json at load.
# The Discord webhook is a bearer credential: anyone holding the URL can post to
# the channel, and a commit publishes it permanently even if later removed.
config/config.local.json

.DS_Store

# Your property. Exact coordinates for stands, bedding, food and water.
# Seeded from config/map.example.json on first run.
config/map.json

# Climate normals, generated by `npm run setup` for your coordinates.
data/normals*.json

# Backups of the sit log and fitted weights. Local by design: they hold your property.
exports/

# Desktop build artifacts. The .dmg is copied to the project root by build:dmg, which is
# why the root copy is ignored too rather than only dist/.
dist/
*.dmg
build/icon.iconset/
build/icon-1024.png

# Records the checkout a build came from, so a fresh install can offer to import from it.
# Machine-specific, regenerated on every build.
electron/build-info.json
